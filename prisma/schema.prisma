generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  emailVerified Boolean @default(true)
  phone String?
  passwordHash String
  name String
  role String @default("INDEPENDENT")
  language String @default("en")
  theme String @default("light")
  createdAt DateTime @default(now())
  /// ACTIVE | SUSPENDED. Suspended accounts cannot sign in and their sessions are revoked.
  status String @default("ACTIVE")
  suspendedAt DateTime?
  /// Throttled (about every 5 minutes) on authenticated requests; feeds DAU/MAU.
  lastActiveAt DateTime?
  /// Coach lifecycle: APPROVED | PENDING | REJECTED | REVOKED. Ignored for other roles.
  coachStatus String @default("APPROVED")
  coachVerifiedAt DateTime?
  coachCredentials String @default("")
  /// Per-coach override of the plan's client allowance. NULL = plan default.
  coachClientLimit Int?
  activityDays UserActivityDay[]
  grants EntitlementGrant[]
  tickets SupportTicket[] @relation("TicketAuthor")
  pushTokens PushToken[]
  profile Profile?
  sessions Session[]
  programs Program[]
  assignedPrograms Program[] @relation("AssignedPrograms")
  assignedMealPlans MealPlan[] @relation("AssignedMealPlans")
  workouts WorkoutSession[]
  meals MealEntry[]
  waters WaterEntry[]
  progress ProgressRecord[]
  coachLinks CoachRelationship[] @relation("Coach")
  clientLinks CoachRelationship[] @relation("Client")
  appointments Appointment[] @relation("AppointmentOwner")
  invitedAppointments Appointment[] @relation("AppointmentGuest")
  sentMessages Message[] @relation("Sender")
  receivedMessages Message[] @relation("Recipient")
  notifications Notification[]
  subscription Subscription?
  recipes Recipe[]
  mealPlans MealPlan[]
  foods Food[]
  performance ExercisePerformance[]
  mealChecks MealPlanCheck[]
  photos ProgressPhoto[]
  resets PasswordReset[]
  emailVerifications EmailVerification[]
  aiInteractions AIInteraction[]
  branding Branding?
  brandLogo BrandLogo?
  brandBackground BrandBackground?
  payments Payment[]
  cardioActivities CardioActivity[]
  dailySteps DailySteps[]
}
model Profile {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  heightCm Float?
  birthYear Int?
  goal String @default("consistency")
  experience String @default("beginner")
  equipment String @default("bodyweight")
  frequency Int @default(3)
  duration Int @default(40)
  dietary String @default("")
  limitations String @default("")
  units String @default("metric")
  timezone String @default("Asia/Jerusalem")
  adult Boolean @default(false)
  onboarded Boolean @default(false)
  aiConsent Boolean @default(false)
  reminders Boolean @default(true)
  calorieTarget Int?
  proteinTarget Int?
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([userId])
}
model PasswordReset {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
}
model EmailVerification {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([userId])
}
model CoachRelationship {
  packages CoachPackage[]
  id String @id @default(cuid())
  coachId String
  clientId String
  coach User @relation("Coach",fields:[coachId],references:[id],onDelete:Cascade)
  client User @relation("Client",fields:[clientId],references:[id],onDelete:Cascade)
  status String @default("PENDING")
  notes String @default("")
  tags String @default("")
  createdAt DateTime @default(now())
  @@unique([coachId,clientId])
  @@index([clientId,status])
}
model CoachPackage {
  id String @id @default(cuid())
  relationshipId String
  relationship CoachRelationship @relation(fields:[relationshipId],references:[id],onDelete:Cascade)
  size Int
  price Int
  date String
  lowBalanceNotified Boolean @default(false)
  sessions CoachTraining[]
  receipts CoachReceipt[]
  @@index([relationshipId,date])
}
model CoachTraining {
  id String @id @default(cuid())
  packageId String
  package CoachPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
  date String
  status String @default("COMPLETED")
  notes String @default("")
  @@index([packageId,date])
}
model CoachReceipt {
  id String @id @default(cuid())
  packageId String
  package CoachPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
  amount Int
  date String
  method String
  notes String @default("")
  @@index([packageId,date])
}
model Exercise {
  id String @id
  nameEn String
  nameHe String
  muscle String
  equipment String
  difficulty String
  instructionsEn String
  instructionsHe String
  performance ExercisePerformance[]
  programExercises ProgramExercise[]
  sets WorkoutSet[]
}
model CardioActivity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  minutes Float
  distanceKm Float?
  date String
  source String @default("manual")
  externalId String
  createdAt DateTime @default(now())
  @@unique([userId,source,externalId])
  @@index([userId,date])
}
model DailySteps {
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  source String
  steps Int
  /// Active energy burned (kcal) reported by the health platform. NULL = not reported.
  activeCalories Int?
  /// Walking/running distance for the whole day (km). NULL = not reported.
  distanceKm Float?
  syncedAt DateTime @default(now())
  @@id([userId,date])
}
model Program {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  name String
  description String @default("")
  weeks Int @default(4)
  days String @default("1,3,5")
  assignedClientId String?
  assignedClient User? @relation("AssignedPrograms",fields:[assignedClientId],references:[id],onDelete:SetNull)
  template Boolean @default(false)
  createdAt DateTime @default(now())
  exercises ProgramExercise[]
  workouts WorkoutSession[]
  @@index([ownerId])
  @@index([assignedClientId])
}
model ProgramExercise {
  id String @id @default(cuid())
  programId String
  program Program @relation(fields:[programId],references:[id],onDelete:Cascade)
  exerciseId String
  exercise Exercise @relation(fields:[exerciseId],references:[id])
  position Int
  sets Int @default(3)
  reps Int @default(10)
  rest Int @default(60)
  weight Float @default(0)
  group String @default("")
  @@index([programId,position])
}
model WorkoutSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  programId String?
  program Program? @relation(fields:[programId],references:[id],onDelete:SetNull)
  name String
  status String @default("ACTIVE")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  elapsedSeconds Int @default(0)
  elapsedMilliseconds Float?
  restUntil DateTime?
  restRemaining Int @default(0)
  lastResumedAt DateTime @default(now())
  notes String @default("")
  performance ExercisePerformance[]
  sets WorkoutSet[]
  @@index([userId,startedAt])
}
model WorkoutSet {
  id String @id @default(cuid())
  sessionId String
  session WorkoutSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  exerciseId String
  exercise Exercise @relation(fields:[exerciseId],references:[id])
  position Int @default(0)
  restSeconds Int @default(60)
  rpe Float?
  setIndex Int
  reps Int
  weight Float
  completed Boolean @default(false)
  @@unique([sessionId,exerciseId,setIndex])
}
model Food {
  id String @id @default(cuid())
  nameEn String
  nameHe String
  calories Float
  protein Float
  carbs Float
  fat Float
  fiber Float @default(0)
  source String @default("original-estimate")
  externalId String?
  brand String?
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  meals MealEntry[]
  ingredients RecipeIngredient[]
  planItems MealPlanItem[]
  units FoodUnit[]
  @@index([ownerId])
  @@unique([source,externalId])
}
model FoodUnit {
  id String @id @default(cuid())
  foodId String
  food Food @relation(fields:[foodId],references:[id],onDelete:Cascade)
  nameHe String
  nameEn String
  grams Float
  position Int @default(0)
  @@index([foodId])
}
model MealEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  foodId String
  food Food @relation(fields:[foodId],references:[id])
  grams Float
  quantity Float?
  unitHe String?
  unitEn String?
  meal String
  date String
  createdAt DateTime @default(now())
  planItemId String?
  planItem MealPlanItem? @relation(fields:[planItemId],references:[id],onDelete:SetNull)
  @@index([userId,date])
  @@index([planItemId])
}
model WaterEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  ml Int
  date String
  @@index([userId,date])
}
model Recipe {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  instructions String
  servings Int @default(1)
  ingredients RecipeIngredient[]
}
model RecipeIngredient {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields:[recipeId],references:[id],onDelete:Cascade)
  foodId String
  food Food @relation(fields:[foodId],references:[id])
  grams Float
}
model MealPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  content String
  menuDate String?
  menuWeekdays String?
  active Boolean @default(true)
  checks MealPlanCheck[]
  items MealPlanItem[]
  assignedClientId String?
  assignedClient User? @relation("AssignedMealPlans",fields:[assignedClientId],references:[id],onDelete:SetNull)
  @@index([assignedClientId])
}
model MealPlanItem {
  id String @id @default(cuid())
  planId String
  plan MealPlan @relation(fields:[planId],references:[id],onDelete:Cascade)
  foodId String
  food Food @relation(fields:[foodId],references:[id])
  meal String
  grams Float
  quantity Float?
  unitHe String?
  unitEn String?
  position Int @default(0)
  entries MealEntry[]
  @@index([planId])
}
model MealPlanCheck {
  planId String
  plan MealPlan @relation(fields:[planId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  meal String @default("")
  @@id([planId,userId,date,meal])
  @@index([userId,date])
}
model ProgressRecord {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  value Float
  unit String
  date String
  note String @default("")
  photos ProgressPhoto[]
  @@index([userId,date])
}
model ExercisePerformance {
  sessionId String
  session WorkoutSession @relation(fields:[sessionId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  exerciseId String
  exercise Exercise @relation(fields:[exerciseId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  weight Float
  reps Int
  estimate Float
  volume Float
  finishedAt DateTime
  @@id([sessionId,exerciseId])
  @@index([userId,exerciseId,finishedAt],map:"performance_user_exercise")
}
model ProgressPhoto {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  image Bytes
  recordId String?
  record ProgressRecord? @relation(fields:[recordId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([recordId])
  @@index([userId,createdAt])
}
model Appointment {
  id String @id @default(cuid())
  ownerId String
  owner User @relation("AppointmentOwner",fields:[ownerId],references:[id],onDelete:Cascade)
  guestId String?
  guest User? @relation("AppointmentGuest",fields:[guestId],references:[id],onDelete:Cascade)
  title String
  kind String @default("MEETING")
  startsAt DateTime
  endsAt DateTime
  status String @default("BOOKED")
  notes String @default("")
  @@index([ownerId,startsAt,endsAt])
  @@index([guestId,startsAt])
}
model Message {
  id String @id @default(cuid())
  senderId String
  recipientId String
  sender User @relation("Sender",fields:[senderId],references:[id],onDelete:Cascade)
  recipient User @relation("Recipient",fields:[recipientId],references:[id],onDelete:Cascade)
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  @@index([recipientId,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  key String
  detail String @default("")
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,read])
}
model Subscription {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tier String @default("FREE")
  status String @default("ACTIVE")
  providerId String? @unique
  customerId String? @unique
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
}
model Payment {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  amount Int
  currency String
  status String
  invoiceUrl String?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model WebhookEvent {
  id String @id
  type String
  processedAt DateTime @default(now())
}
model Branding {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  businessName String
  color String @default("#16715b")
  welcome String @default("")
  /// Set when a logo exists; doubles as the cache-busting version of the image URL.
  logoAt DateTime?
  /// Set when a background image exists; doubles as the cache-busting version of its URL.
  backgroundAt DateTime?
}
/// Kept apart from Branding so the image bytes are never loaded with the session user.
model BrandLogo {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  image Bytes
}
/// Kept apart from Branding so the image bytes are never loaded with the session user.
model BrandBackground {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  image Bytes
}
model AIInteraction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  prompt String
  response String
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  resetsAt DateTime
}
model FeatureFlag {
  key String @id
  enabled Boolean @default(false)
}
/// One row per user per day with authenticated activity (DAU/MAU/retention source).
model UserActivityDay {
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  @@id([userId,date])
  @@index([date])
}
/// Complimentary or promotional access that does not pass through a payment provider.
model EntitlementGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  /// PREMIUM | AD_FREE | COACH | AI
  kind String
  /// ADMIN | PROMO
  source String @default("ADMIN")
  reason String @default("")
  startsAt DateTime @default(now())
  endsAt DateTime?
  revokedAt DateTime?
  createdBy String?
  promotionId String?
  createdAt DateTime @default(now())
  @@index([userId,endsAt])
  @@unique([userId,promotionId])
}
model Promotion {
  id String @id @default(cuid())
  code String @unique
  /// PREMIUM | AD_FREE
  kind String
  days Int
  maxRedemptions Int?
  redemptions Int @default(0)
  /// ALL | INDEPENDENT | COACH
  audience String @default("ALL")
  startsAt DateTime @default(now())
  endsAt DateTime?
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
}
/// Administrative identities are separate from app users: no app role can reach the console.
model AdminAccount {
  id String @id @default(cuid())
  email String @unique
  name String
  /// SUPER_ADMIN | SUPPORT_ADMIN | CONTENT_MANAGER | FINANCE_ADMIN | TECHNICAL_ADMIN
  role String
  passwordHash String?
  /// AES-256-GCM encrypted base32 TOTP secret.
  totpSecret String?
  totpEnabledAt DateTime?
  lastTotpStep Int?
  /// Comma-separated SHA-256 digests of unused recovery codes.
  recoveryCodes String @default("")
  /// INVITED | ACTIVE | DISABLED
  status String @default("INVITED")
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  inviteTokenHash String? @unique
  inviteExpiresAt DateTime?
  createdBy String?
  createdAt DateTime @default(now())
  sessions AdminSession[]
}
model AdminSession {
  /// SHA-256 of the cookie token.
  id String @id
  adminId String
  admin AdminAccount @relation(fields:[adminId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  /// Last successful step-up (second factor re-entry) for sensitive operations.
  reauthAt DateTime?
  userAgent String @default("")
  @@index([adminId])
}
/// Password verified, second factor pending.
model AdminChallenge {
  id String @id
  adminId String
  expiresAt DateTime
  attempts Int @default(0)
}
/// Append-only: database triggers reject UPDATE and DELETE.
model AdminAuditLog {
  id String @id @default(cuid())
  adminId String
  adminEmail String
  action String
  resourceType String
  resourceId String?
  details String @default("{}")
  /// SUCCESS | FAILURE | DENIED
  result String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([adminId,createdAt])
  @@index([resourceType,resourceId])
}
/// Remote configuration history. The highest version is live; rollback appends a copy.
model ConfigVersion {
  version Int @id @default(autoincrement())
  data String
  note String @default("")
  createdBy String
  createdAt DateTime @default(now())
}
model AIProvider {
  /// openai | anthropic | gemini | groq | openrouter
  id String @id
  name String
  baseUrl String
  /// AES-256-GCM encrypted. Never returned to clients.
  encryptedKey String?
  keyHint String @default("")
  enabled Boolean @default(false)
  textModel String @default("")
  visionModel String @default("")
  /// USD per million tokens, for cost estimates.
  inputCostPerM Float @default(0)
  outputCostPerM Float @default(0)
  lastCheckedAt DateTime?
  lastStatus String @default("unknown")
  updatedAt DateTime @default(now())
}
model AIUsage {
  id String @id @default(cuid())
  userId String?
  feature String
  provider String
  model String
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  /// Estimated cost in millionths of a USD.
  costMicros Int @default(0)
  success Boolean
  latencyMs Int
  error String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId,createdAt])
}
model AdStatDay {
  date String
  placement String
  impressions Int @default(0)
  clicks Int @default(0)
  @@id([date,placement])
}
/// Revenue reported by the ad network (AdMob/AdSense), recorded by finance.
model AdRevenue {
  id String @id @default(cuid())
  month String
  network String
  amountCents Int
  currency String @default("usd")
  note String @default("")
  createdBy String
  createdAt DateTime @default(now())
  @@unique([month,network])
}
model ContentItem {
  id String @id @default(cuid())
  /// ARTICLE | FAQ
  type String
  slug String @unique
  category String @default("")
  titleEn String
  titleHe String
  bodyEn String
  bodyHe String
  /// DRAFT | PUBLISHED | ARCHIVED
  status String @default("DRAFT")
  position Int @default(0)
  version Int @default(1)
  updatedBy String
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([type,status])
}
/// Snapshot of every content edit, for history and restore.
model ContentRevision {
  id String @id @default(cuid())
  /// content | exercise | food | translation
  entityType String
  entityId String
  version Int
  data String
  createdBy String
  createdAt DateTime @default(now())
  @@index([entityType,entityId,version])
}
/// Edits layered over the bundled exercise catalog without rewriting the dataset.
model ExerciseOverride {
  exerciseId String @id
  nameEn String?
  nameHe String?
  instructionsEn String?
  instructionsHe String?
  muscle String?
  difficulty String?
  hidden Boolean @default(false)
  version Int @default(1)
  updatedBy String
  updatedAt DateTime @default(now())
}
model TranslationOverride {
  key String @id
  en String?
  he String?
  updatedBy String
  updatedAt DateTime @default(now())
}
model Announcement {
  id String @id @default(cuid())
  titleEn String
  titleHe String
  bodyEn String
  bodyHe String
  /// ALL | COACHES | INDEPENDENT | COACH_CLIENTS | PREMIUM | USERS
  audience String
  userIds String @default("")
  inApp Boolean @default(true)
  push Boolean @default(false)
  /// DRAFT | SCHEDULED | SENDING | SENT | CANCELLED | FAILED
  status String @default("DRAFT")
  scheduledAt DateTime?
  sentAt DateTime?
  recipients Int @default(0)
  pushSent Int @default(0)
  pushFailed Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  @@index([status,scheduledAt])
}
model PushToken {
  token String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  platform String
  createdAt DateTime @default(now())
  @@index([userId])
}
model SupportTicket {
  id String @id @default(cuid())
  userId String?
  user User? @relation("TicketAuthor",fields:[userId],references:[id],onDelete:SetNull)
  email String
  /// SUPPORT | BUG | FEATURE | COMPLAINT | REPORT
  category String
  subject String
  /// OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  status String @default("OPEN")
  /// LOW | NORMAL | HIGH | URGENT
  priority String @default("NORMAL")
  assigneeId String?
  /// The account a REPORT or COMPLAINT is about.
  reportedUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  messages TicketMessage[]
  @@index([status,priority])
  @@index([userId])
  @@index([reportedUserId])
}
model TicketMessage {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  /// USER | ADMIN
  authorType String
  adminId String?
  body String
  /// Internal notes are never shown to the user.
  internal Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([ticketId,createdAt])
}
/// Hourly request counters per route group (no payloads, no identifiers).
model ApiMetric {
  hour String
  route String
  count Int @default(0)
  errors Int @default(0)
  clientErrors Int @default(0)
  totalMs Int @default(0)
  maxMs Int @default(0)
  @@id([hour,route])
}
model RequestError {
  id String @id @default(cuid())
  route String
  method String
  status Int
  code String
  durationMs Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model JobRun {
  id String @id @default(cuid())
  job String
  /// RUNNING | SUCCESS | FAILED
  status String
  detail String @default("")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  @@index([job,startedAt])
}
