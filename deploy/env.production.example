# Copy to deploy/.env.production ON THE SERVER (chmod 600). Never commit real values.

# Domains (DNS A/AAAA records must point at the VPS before first start; Caddy then
# obtains Let's Encrypt certificates automatically).
APP_DOMAIN=app.example.com
ADMIN_HOST=admin.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://app.example.com

# Required secrets. Generate with: openssl rand -hex 32
ADMIN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 24  (32+ characters)
CRON_SECRET=

# Optional integrations (leave empty to keep them off).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_FALLBACK_MODEL=
OPENAI_VISION_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_COACH=
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PREMIUM=
PAYPAL_PLAN_COACH=
EXPO_ACCESS_TOKEN=
WORKOUTX_API_KEY=

# Backups kept on the data volume (copy them off-server too).
BACKUP_KEEP=14
APP_ENV=production

# Google AdSense (web, Free plan only). Paid plans never load it.
ADSENSE_CLIENT=
ADSENSE_SLOT=
