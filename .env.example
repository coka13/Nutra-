DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
DEMO_ENABLED="true"
# Required for real AI; never exposed to the browser
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Optional: any OpenAI-compatible API. For OpenRouter free models:
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_MODEL="nvidia/nemotron-3.5-super-vl:free"
# OPENAI_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free"  (comma-separated, tried in order)
OPENAI_BASE_URL=""
OPENAI_FALLBACK_MODEL=""
# Optional: model(s) for meal-photo recognition; must accept images. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=""
# Provision email delivery before production password recovery
RESEND_API_KEY=""
EMAIL_FROM=""
# Optional Stripe test mode first. Price IDs must be recurring prices.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_COACH=""
PAYPAL_ENV=""            # "live" for real payments; anything else uses the PayPal sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_PREMIUM=""   # PayPal billing plan for Plus ($5/month)
PAYPAL_PLAN_COACH=""     # PayPal billing plan for Coach ($30/month)


# --- Administration console -------------------------------------------------------------
# Dedicated admin host (e.g. admin.example.com). The console exists only on this host.
# Unset in development = console served on any host; in production it is then disabled
# unless ADMIN_ALLOW_SHARED_HOST="true" is set deliberately.
ADMIN_HOST=""
ADMIN_ALLOW_SHARED_HOST=""
# 32 bytes (openssl rand -hex 32). Encrypts TOTP seeds and AI provider keys. Required in
# production; changing it makes saved TOTP enrolments and AI keys unreadable.
ADMIN_ENCRYPTION_KEY=""
# 32+ characters. Enables POST /api/jobs/run for the scheduler (announcements, cleanup, backups).
CRON_SECRET=""
# Redirect http->https based on X-Forwarded-Proto from the TLS proxy (production only).
ENFORCE_HTTPS=""
# Backups (VACUUM INTO snapshots). Defaults to <database dir>/backups, keeps 14.
BACKUP_DIR=""
BACKUP_KEEP=""
# Optional Expo push access token (only if "Enhanced security for push" is enabled in Expo).
EXPO_ACCESS_TOKEN=""
# Shown on the System page.
GIT_SHA=""
APP_ENV=""

# Contact address shown on /privacy for data requests (public, baked in at build time).
NEXT_PUBLIC_PRIVACY_EMAIL=""

# Google AdSense (web, Free plan only). Paid plans never load it.
ADSENSE_CLIENT=
ADSENSE_SLOT=
