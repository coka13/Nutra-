# Optional for Expo development on LAN. Required for release builds.
# EXPO_PUBLIC_NUTRI_URL=https://your-nutri-host.example

# AdMob: off | test | live. Test is the default, including preview/release builds.
EXPO_PUBLIC_ADMOB_MODE=test
# App IDs contain ~. Changes require a new native build.
ADMOB_IOS_APP_ID=ca-app-pub-3933096627211440~5867449397
# Set your own Android App ID before enabling live Android ads.
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# Banner ad unit IDs contain / and are separate for each platform.
# EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
