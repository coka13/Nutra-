# Upload only mobile build inputs and the one shared health-data type source.
/*
!/mobile
/mobile/*
!/mobile/src
!/mobile/assets
!/mobile/package.json
!/mobile/package-lock.json
!/mobile/app.json
!/mobile/app.config.js
!/mobile/local-preview.js
!/mobile/eas.json
!/mobile/tsconfig.json
!/mobile/eslint.config.js
!/src
/src/*
!/src/lib
/src/lib/*
!/src/lib/activity.ts

# Exclude secrets and generated files even inside allowed directories.
**/node_modules/
**/.env*
!**/.env.example
**/*.db
**/*.db-journal
**/*.tsbuildinfo
**/.expo/
**/.cache/
**/.claude/
**/.agents/
.next/
next-env.d.ts
.next-panic*
test-results/
playwright-report/
tmp/
exports/
public/
prisma/
docs/
src/data/
# Generate native projects in the cloud so config plugins (including AdMob) run.
mobile/android/
mobile/ios/
mobile/dist/
mobile/dist-health-check/
mobile/web-build/
mobile/.metro-health-check*
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision
**/credentials.json
